# ──────────────────────────────────────────────
# Apuestas Deportivas — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ──────────────────────────────────────────────

# ── General ──
NODE_ENV=development

# ── PostgreSQL (Docker) ──
POSTGRES_USER=apuestas
POSTGRES_PASSWORD=apuestas_dev
POSTGRES_DB=apuestas_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://apuestas:apuestas_dev@localhost:5432/apuestas_dev
TEST_DATABASE_URL=postgresql://apuestas:apuestas_dev@localhost:5432/apuestas_test

# ── Redis (Docker) ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API (NestJS) ──
API_PORT=3001
# Prefijo con el que la web expone la API (proxy de Next.js); define la ruta de la cookie de refresh
PUBLIC_API_PREFIX=/api
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# 32 bytes en base64 para cifrar los secretos TOTP: `openssl rand -base64 32`
TOTP_ENC_KEY=change-me-32-bytes-base64
# Primer administrador, lo crea `prisma db seed`
ADMIN_EMAIL=admin@apuestas.local
ADMIN_PASSWORD=change-me-admin-password

# ── Correo (Mailpit en Docker) ──
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Apuestas Deportivas <no-reply@apuestas.local>"

# ── CAPTCHA (Cloudflare Turnstile; estas son las claves de prueba que siempre aprueban) ──
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── Retiros ──
WITHDRAWAL_REVIEW_THRESHOLD_CENTS=20000

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:3001
# Destino del proxy /api/* de Next.js (servidor de la web → API)
API_URL=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_REPORTS_URL=http://localhost:8000

# ── Reports (FastAPI) ──
REPORTS_PORT=8000
REPORTS_DATABASE_URL=postgresql://apuestas_readonly:apuestas_dev@localhost:5432/apuestas_dev

# ── API-Football ──
API_FOOTBALL_KEY=your-api-key-here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ── Payphone (sandbox) ──
PAYPHONE_TOKEN=your-payphone-token-here
PAYPHONE_STORE_ID=your-store-id-here
PAYPHONE_RESPONSE_URL=http://localhost:3000/api/payments/payphone/return
PAYPHONE_BASE_URL=https://pay.payphonetodoesposible.com
