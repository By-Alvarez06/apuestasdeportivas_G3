# ──────────────────────────────────────────────
# Apuestas Deportivas — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ──────────────────────────────────────────────

# ── General ──
NODE_ENV=development

# ── PostgreSQL (Docker) ──
POSTGRES_USER=apuestas
POSTGRES_PASSWORD=apuestas_dev
POSTGRES_DB=apuestas_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://apuestas:apuestas_dev@localhost:5432/apuestas_dev

# ── Redis (Docker) ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API (NestJS) ──
API_PORT=3001
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REPORTS_URL=http://localhost:8000

# ── Reports (FastAPI) ──
REPORTS_PORT=8000
REPORTS_DATABASE_URL=postgresql://apuestas_readonly:apuestas_dev@localhost:5432/apuestas_dev

# ── API-Football ──
API_FOOTBALL_KEY=your-api-key-here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ── Payphone (sandbox) ──
PAYPHONE_TOKEN=your-payphone-token-here
PAYPHONE_STORE_ID=your-store-id-here
