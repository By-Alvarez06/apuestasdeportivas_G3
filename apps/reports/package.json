{
  "name": "@apuestas/reports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd apps/reports && python -m uvicorn app.main:app --reload --port 8000",
    "lint": "cd apps/reports && ruff check .",
    "lint:fix": "cd apps/reports && ruff check . --fix",
    "typecheck": "echo 'Python type checking via ruff'",
    "test": "cd apps/reports && python -m pytest",
    "test:ci": "cd apps/reports && python -m pytest --tb=short -q",
    "build": "echo 'No build step for Python service'",
    "clean": "find apps/reports -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; true"
  }
}
