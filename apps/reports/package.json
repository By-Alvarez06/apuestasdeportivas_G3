{
  "name": "@apuestas/reports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs python -m uvicorn app.main:app --reload --port 8000",
    "lint": "node scripts/run.mjs ruff check .",
    "lint:fix": "node scripts/run.mjs ruff check . --fix",
    "typecheck": "echo 'Python type checking via ruff'",
    "test": "node scripts/run.mjs pytest",
    "test:ci": "node scripts/run.mjs pytest --tb=short -q",
    "build": "echo 'No build step for Python service'",
    "clean": "node scripts/run.mjs clean"
  }
}
