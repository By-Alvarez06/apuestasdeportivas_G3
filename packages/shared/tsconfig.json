{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Se compila a CommonJS porque la API corre con `node dist/main` y no puede cargar .ts.
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"]
}
